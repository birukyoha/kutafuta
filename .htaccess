# ==============================================================================
# Apache Rewrite Rules for KutafutaTalent Single Page Application (SPA) & PHP API
# cPanel Shared Hosting Deployment Configuration
# Compatible with Root Domain & Subfolder Deployments
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Route API requests to PHP Router Controller
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]

  # 2. Redirect all non-file/non-directory client SPA routes to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# MIME Types & Compression Optimization
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Security Headers
# Add this at the bottom of your existing .htaccess file

# Prevent caching of index.html so updates load instantly
<IfModule mod_headers.c>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# Cache long-term assets since Vite hashes their names
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>